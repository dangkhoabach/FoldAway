# Logs
logs
*.log

# Local signing identity for this machine (CODE_SIGN_IDENTITY) — never commit
Local.xcconfig

# Local build output — reproducible
release-output/
# Sparkle CLI tools downloaded by scripts/release.sh
.sparkle-tools/

# Xcode / Swift Package Manager. Tracked inside the .xcodeproj: project.pbxproj,
# the shared scheme (serial build order, see docs/release.md) and the
# workspace's Package.resolved (Sparkle pin).
build/
.build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcuserstate
xcuserdata/
.swiftpm/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp

# Coverage data left behind by xcodebuild test
*.profraw
