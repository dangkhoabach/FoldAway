    },
    "Waiting for your approval in System Settings › General › Login Items. Until then DKB Clamshell won't start at login.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ bạn cho phép trong System Settings › General › Login Items. Trước đó DKB Clamshell sẽ không khởi động cùng máy."
          }
        }
      }
    },
    "Without Screen Recording only Lite (system blur) is available.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cho phép Ghi màn hình nên chỉ dùng được Lite (làm mờ của hệ thống)."
