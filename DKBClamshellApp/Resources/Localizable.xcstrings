    "Blur": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ mờ"
          }
        }
      }
    },
    "Both work from any app, even while the screen is dark: they hide the effect first, then change the setting.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai dùng được ở mọi app, kể cả khi màn hình đang tối: ẩn hiệu ứng trước rồi mới đổi cài đặt."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huỷ"
          }
        }
      }
    },
