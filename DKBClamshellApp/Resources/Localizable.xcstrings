      }
    },
    "Checks updates.dangkhoabach.vn once a day. Turning this off means updates only happen when you ask for them.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra updates.dangkhoabach.vn mỗi ngày một lần. Tắt đi thì chỉ cập nhật khi bạn tự yêu cầu."
          }
        }
      }
    },
