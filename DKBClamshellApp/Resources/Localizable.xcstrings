    "Allow…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép…"
          }
        }
      }
    },
    "Another app already uses this shortcut, so it does nothing here. Choose a different one.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một app khác đã dùng tổ hợp này nên ở đây không có tác dụng. Hãy chọn tổ hợp khác."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động"
          }
        }
      }
    },
    "Back to defaults": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Về mặc định"
          }
        }
